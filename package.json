{
  "name": "finspotter",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "extensions/**/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "sst dev",
    "update": "pnpm up -riL",
    "drizzle-kit": "pnpm --filter @finspotter/core drizzle-kit",
    "create-admin": "pnpm --filter @finspotter/core create-admin",
    "reset-deps": "rm -rf node_modules pnpm-lock.yaml && pnpm store prune && pnpm install",
    "sso": "aws sso login --sso-session=dylanirion"
  },
  "dependencies": {
    "@finspotter/annotation-bbox_xywh": "workspace:*",
    "@finspotter/annotation-bbox_xywha": "workspace:*",
    "@finspotter/annotation-bbox_xywha_segmentation": "workspace:*",
    "@finspotter/annotation-segmentation": "workspace:*",
    "@finspotter/annotations": "workspace:*",
    "@finspotter/faiss": "workspace:*",
    "@finspotter/hesaff": "workspace:*",
    "@finspotter/homog": "workspace:*",
    "@finspotter/pgvector": "workspace:*",
    "@finspotter/pipeline": "workspace:*",
    "@finspotter/ratio": "workspace:*",
    "@finspotter/sum": "workspace:*",
    "@finspotter/web": "workspace:*",
    "@finspotter/yolact": "workspace:*",
    "sst": "4.17.1"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.918.0",
    "@eslint/js": "^9.38.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.0",
    "@tsconfig/node22": "^22.0.2",
    "@types/express": "^5.0.5",
    "@types/node": "^24.9.1",
    "drizzle-orm": "^1.0.0-rc.4",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "express": "^5.1.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2",
    "typescript-eslint": "8.46.2"
  }
}